{
  "_comment": "Brain layout — the canonical vault folders, what file-keys route to each (for the mindmap/brain-structure design) and which collector buckets render there (for the builder). Override with --mappings <dir>/brain/layout.json. Keep in sync with the LAYER_ROUTES default in diagrams.py.",
  "taxonomy": "canonical-pruned",
  "quarantine_folder": "_quarantine",
  "layers": [
    { "folder": "00-me", "title": "00-me · identity", "buckets": ["identity"],
      "purpose": "Identity: profile, positions, education, skills, certs, languages",
      "route_keys": ["profile","profilesummary","positions","skills","education",
                     "certifications","languages","patents","volunteering","workinghours",
                     "personalinformation","instagramprofileinformation"] },
    { "folder": "10-people", "title": "10-people", "buckets": ["people"],
      "purpose": "One merged note per person across all sources",
      "route_keys": ["connections","memberfollows","invitations","followers","following","friends","contacts"] },
    { "folder": "15-organizations", "title": "15-organizations", "buckets": ["orgs"],
      "purpose": "Companies you follow / worked at / targeted",
      "route_keys": ["companyfollows"] },
    { "folder": "20-reputation", "title": "20-reputation", "buckets": ["reputation"],
      "purpose": "Recommendations + endorsements (given & received)",
      "route_keys": ["recommendationsreceived","recommendationsgiven",
                     "endorsementreceivedinfo","endorsementgiveninfo"] },
    { "folder": "30-voice", "title": "30-voice", "buckets": ["posts","comments","reactions","interests"],
      "purpose": "Your posts, comments, reactions, interests, saved items",
      "route_keys": ["shares","instantreposts","comments","reactions","votes",
                     "hashtagfollows","saveditems","richmedia","articles","posts",
                     "likedposts","yourtopics"] },
    { "folder": "40-career", "title": "40-career", "buckets": ["applications","prefs","saved_jobs","reusable"],
      "purpose": "Job applications, preferences, saved jobs, reusable answers",
      "route_keys": ["jobapplications","jobseekerpreferences","savedjobs","savedjobalerts",
                     "onlinejobpostings","jobapplicantsavedanswers",
                     "jobapplicantsavedscreeningquestionresponses"] },
    { "folder": "50-mirror", "title": "50-mirror", "buckets": ["mirror_inferences","ad_segments"],
      "purpose": "How algorithms see you: inferences + ad targeting",
      "route_keys": ["inferencesaboutyou","adtargeting","adsclicked","lanadsengagement"] },
    { "folder": "60-learning", "title": "60-learning", "buckets": ["learning_count"],
      "purpose": "Courses / learning activity",
      "route_keys": ["learning","learningcoachmessages","learningroleplaymessages"] },
    { "folder": "70-services", "title": "70-services", "buckets": ["services"],
      "purpose": "Services-marketplace engagements & providers",
      "route_keys": ["engagements","opprtunities","opportunities","providers"] },
    { "folder": "80-search", "title": "80-search", "buckets": ["searches"],
      "purpose": "Your search history (topics over time)",
      "route_keys": ["searchqueries","recentsearches","profilesearches"] },
    { "folder": "85-places", "title": "85-places", "buckets": ["places"],
      "purpose": "Saved / reviewed locations (Google Maps, check-ins)",
      "route_keys": ["savedplaces","reviews","locationsofinterest","yourplaces"] },
    { "folder": "events", "title": "events / calendar", "buckets": ["events"],
      "purpose": "Events / calendar",
      "route_keys": ["events","calendar"] }
  ]
}
