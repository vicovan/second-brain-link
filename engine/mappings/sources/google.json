{
  "_comment": "Google Takeout source mapping — interpreted by engine/scripts/mapping.py. Maps (Your Places) Saved Places + Reviews -> 85-places/ (locate 'geojson_features' walks features[]; geometry.coordinates[0]=lng, [1]=lat per GeoJSON lng,lat order); Contacts CSV -> people (emails/phones dropped by the Collector); YouTube subscriptions -> interests. Wins over the Python google.py adapter. ['a','b'] = first non-empty; {const:x} = literal. See engine/references/blueprint.md.",
  "name": "google",
  "subject": "person",
  "detect": {
    "path_contains": [
      "takeout",
      "maps (your places)",
      "maps(your places)",
      "youtube and youtube music",
      "google account"
    ]
  },
  "quarantine": [
    "access log activity",
    "passwords",
    "recovery",
    "security"
  ],
  "records": [
    {
      "match": {
        "path_contains": [
          "maps (your places)/saved places",
          "saved places"
        ]
      },
      "locate": "geojson_features",
      "emit": "place",
      "fields": {
        "name": [
          "properties.location.name",
          "properties.Title",
          "properties.name"
        ],
        "address": "properties.location.address",
        "lng": "geometry.coordinates[0]",
        "url": "properties.google_maps_url",
        "date": "properties.date",
        "kind": {
          "const": "saved"
        },
        "lat": "geometry.coordinates[1]"
      }
    },
    {
      "match": {
        "path_contains": [
          "maps (your places)/reviews",
          "reviews"
        ]
      },
      "locate": "geojson_features",
      "emit": "place",
      "fields": {
        "name": [
          "properties.location.name",
          "properties.name"
        ],
        "address": "properties.location.address",
        "lng": "geometry.coordinates[0]",
        "url": "properties.google_maps_url",
        "note": "properties.review_text_published",
        "date": "properties.date",
        "kind": {
          "const": "reviewed"
        },
        "lat": "geometry.coordinates[1]"
      }
    },
    {
      "match": {
        "path_contains": [
          "contacts"
        ],
        "suffix": ".csv"
      },
      "locate": "auto_array",
      "emit": "person",
      "fields": {
        "name": [
          "Name",
          "File As",
          "Given Name"
        ],
        "company": [
          "Organization Name",
          "Organization 1 - Name"
        ],
        "role": [
          "Organization Title",
          "Organization 1 - Title"
        ]
      }
    },
    {
      "match": {
        "path_contains": [
          "subscriptions"
        ],
        "name_contains": [
          "subscription"
        ],
        "suffix": ".csv"
      },
      "locate": "auto_array",
      "emit": "interest",
      "fields": {
        "tag": [
          "Channel Title",
          "Channel Id",
          "Title"
        ]
      }
    }
  ]
}
