  "content_rules": [
    {
      "id": "private-key-block",
      "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----"
    },
    {
      "id": "aws-access-key",
      "regex": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|AIPA)[0-9A-Z]{16}\\b"
    },
    {
      "id": "aws-secret-near-key",
      "regex": "(?i)aws.{0,20}(?:secret|private).{0,20}[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}\\b"
    },
    {
      "id": "gcp-service-account",
      "regex": "\"type\"\\s*:\\s*\"service_account\"|\"private_key_id\"\\s*:\\s*\"[0-9a-f]{20,}\""
    },
    {
      "id": "gcp-api-key",
      "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b"
    },
    {
      "id": "github-token",
      "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,}\\b"
    },
    {
      "id": "gitlab-token",
      "regex": "\\bglpat-[A-Za-z0-9_\\-]{20,}\\b"
    },
    {
      "id": "slack-token",
      "regex": "\\bxox[abposr]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "slack-webhook",
      "regex": "hooks\\.slack\\.com/services/T[A-Za-z0-9]+/B[A-Za-z0-9]+/[A-Za-z0-9]{20,}"
    },
    {
      "id": "stripe-key",
      "regex": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}\\b"
    },
    {
      "id": "anthropic-key",
      "regex": "\\bsk-ant-[A-Za-z0-9_\\-]{20,}"
    },
    {
      "id": "openai-key",
      "regex": "\\bsk-(?:proj-)?[A-Za-z0-9_\\-]{20,}"
    },
    {
      "id": "sendgrid-key",
      "regex": "\\bSG\\.[A-Za-z0-9_\\-]{16,}\\.[A-Za-z0-9_\\-]{16,}"
    },
    {
      "id": "twilio-key",
      "regex": "\\bSK[0-9a-fA-F]{32}\\b"
    },
    {
      "id": "twilio-auth-pair",
      "regex": "\\bAC[0-9a-f]{32}\\b[\\s\\S]{0,200}?(?i:auth[_ -]?token)"
    },
    {
      "id": "mailgun-key",
      "regex": "\\bkey-[0-9a-f]{32}\\b"
    },
    {
      "id": "npm-token",
      "regex": "\\bnpm_[A-Za-z0-9]{36}\\b"
    },
    {
      "id": "jwt",
      "regex": "\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,}"
    },
    {
      "id": "basic-auth-url",
      "regex": "\\b[a-z][a-z0-9+.\\-]{1,15}://[^\\s/:@\"'<>]{1,64}:[^\\s/@\"'<>]{3,128}@[A-Za-z0-9.\\-]+"
    },
    {
      "id": "db-connection-string",
      "regex": "(?i)\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|rediss|amqps?|mssql|sqlserver)://[^\\s:@\"'<>]+:[^\\s@\"'<>]{3,}@"
    },
    {
      "id": "bearer-token",
      "regex": "(?i)\\bauthorization\\s*[:=]\\s*[\"']?bearer\\s+[A-Za-z0-9_\\-.=]{20,}"
    },
    {
      "id": "generic-assignment",
      "regex": "(?i)(?<![A-Za-z0-9])[\"']?(?:pass(?:word|wd|phrase)?|pwd|secret|client[_\\- ]?secret|api[_\\- ]?key|apikey|access[_\\- ]?key|secret[_\\- ]?key|auth[_\\- ]?token|access[_\\- ]?token|refresh[_\\- ]?token|private[_\\- ]?key|token)[\"']?\\s*[:=]\\s*[\"']?([^\\s\"',;<>`]{6,})",
      "value_group": 1,
      "line_guard": "(?i)example|placeholder|redacted|dummy|sample|<your|your[-_ ]|xxxx|\\*\\*\\*|changeme|lorem"
    },
    {
      "id": "env-snapshot",
      "regex": "(?m)^\\s*(?:export\\s+)?[A-Z][A-Z0-9_]*(?:KEY|SECRET|TOKEN|PASS|PASSWORD|PWD|CRED|CREDENTIALS|AUTH)[A-Z0-9_]*\\s*=\\s*[\"']?[^\\s\"'#]{8,}",
      "value_guard": true,
      "min_hits": 2
    },
    {
      "id": "postman-environment",
      "regex": "\"_postman_variable_scope\"\\s*:\\s*\"(?:environment|globals)\""
    },
    {
      "id": "high-entropy-near-key",
      "regex": "(?i)(?:secret|api[_\\- ]?key|token|password|passwd|auth|bearer|private[_\\- ]?key|signing[_\\- ]?key)[^\\n]{0,40}?[\"'=:\\s]([A-Za-z0-9+/=_\\-]{32,})",
      "value_group": 1,
      "min_entropy": 4.3
    }
  ],
  "placeholder_guard": "(?i)^(?:<.*>|\\{\\{.*\\}\\}|\\$\\{?.*|%.*%|\\*{3,}.*|x{4,}.*|\\.\\.\\..*|your[-_].*|my[-_].*|example.*|sample.*|redacted.*|changeme.*|change[-_]me.*|null|none|nil|undefined|true|false|todo.*|tbd.*|placeholder.*|secret|password|token|string|required|optional|env\\(.*|process\\.env.*|os\\.environ.*|config\\..*|settings\\..*|getenv.*|\\[.*\\]|\\(.*\\)|[-_.]+|0+|1234.*|abc.*|test.*|demo.*|fake.*|dummy.*)$",
  "value_hash_guard": "^(?:[0-9a-f]{32}|[0-9a-f]{40}|[0-9a-f]{64}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
  "entropy_guard": "(?i)data:image|integrity=|sha256-|sha384-|sha512-|/|\\\\",
  "card_rule": {
    "id": "card-luhn",
    "test_pans": [
      "4111111111111111",
      "4242424242424242",
      "4000056655665556",
      "5555555555554444",
      "5200828282828210",
      "5105105105105100",
      "378282246310005",
      "371449635398431",
      "6011111111111117",
      "6011000990139424",
      "3056930009020004",
      "36227206271667",
      "3566002020360505",
      "6200000000000005",
      "4000000000000002",
      "4000000000009995",
      "4000000000000077",
      "4000000000000093",
      "4000000000000119",
      "4000000000003220",
      "4000002500003155",
      "4000000000000069",
      "4000000000000127",
      "2223003122003222",
      "4012888888881881",
      "5454545454545454",
      "4917610000000000",
      "4917484589897107",
      "4444333322221111"
    ],
    "min_hits": 1
  },
  "iban_rule": {
    "id": "iban",
    "regex": "\\b(?:AT|BE|BG|CH|CY|CZ|DE|DK|EE|ES|FI|FR|GB|GR|HR|HU|IE|IS|IT|LI|LT|LU|LV|MC|MT|NL|NO|PL|PT|RO|SE|SI|SK|SM|AE|SA|QA|BH|KW|IL|TR|JO|LB)\\d{2}(?: ?[A-Z0-9]{4}){3,7}(?: ?[A-Z0-9]{1,4})?\\b",
    "min_hits": 1
  },
  "pii_dense": {
    "emails": 20,
    "phones": 10
  },
  "limits": {
    "max_scan_bytes": 20971520,
    "max_body_chars": 60000,
    "max_hash_bytes": 524288000,
    "archive_list_cap": 200
  },
  "policies": {
    "archive": "stub",
    "unscannable": "copy-unverified",
    "neighbour_flagged": "stub",
    "pdf_min_chars": 200
  }
}
