{
  "_comment": "Tiered sensitivity rules for the document-store sources (git_docs, google_drive), read by scripts/docscan.py. DETERMINISTIC + LOCAL: no AI, no network. A file that trips any rule becomes a metadata-only STUB in the brain (its content never enters the vault); a clean file is imported. Reasons are rule ids only - never the matched text. Override per company with a file of the same shape (merged by `id`; {\"id\": \"...\", \"disabled\": true} switches a shipped rule off) passed through the link file's rules.sensitivity or a --mappings <dir>/docs/sensitivity.json.",
  "version": 1,
  "exclude": [
    {
      "id": "os-litter",
      "names": [
        ".DS_Store",
        "Thumbs.db",
        "desktop.ini",
        "Icon\r",
        ".localized"
      ]
    },
    {
      "id": "vcs-internals",
      "segments": [
        ".git",
        ".svn",
        ".hg"
      ]
    },
    {
      "id": "dependency-dirs",
      "segments": [
        "node_modules",
        "__pycache__",
        ".venv",
        "venv",
        ".pytest_cache",
        ".mypy_cache",
        ".tox",
        ".next",
        ".turbo",
        ".cache"
      ]
    },
    {
      "id": "editor-state",
      "segments": [
        ".obsidian",
        ".trash",
        ".idea",
        ".vscode"
      ]
    },
    {
      "id": "compiled",
      "exts": [
        ".pyc",
        ".pyo",
        ".class",
        ".o",
        ".so",
        ".dylib",
        ".dll",
        ".exe"
      ]
    },
    {
      "id": "lockfiles",
      "names": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "poetry.lock",
        "Pipfile.lock",
        "Cargo.lock",
        "Gemfile.lock",
        ".gitignore",
        ".gitattributes",
        ".gitmodules",
        ".gitkeep"
      ]
    }
  ],
  "sensitive_paths": [
    {
      "id": "path-secrets",
      "segments": [
        "secret",
        "secrets",
        "credential",
        "credentials",
        "keys",
        "certs",
        "certificates",
        ".ssh",
        ".aws",
        ".gnupg",
        ".kube",
        ".docker"
      ]
    },
    {
      "id": "path-env-vars",
      "segments": [
        "env",
        "envs",
        "environments",
        "vars",
        "gcp-vars",
        "aws-vars",
        "env-vars",
        "dotenv"
      ],
      "segment_suffixes": [
        "-vars",
        "_vars",
        "-env",
        "_env",
        "-secrets"
      ]
    },
    {
      "id": "path-security-testing",
      "segments": [
        "pen-test",
        "pen-tests",
        "pentest",
        "pentests",
        "penetration-test",
        "penetration-tests",
        "zap",
        "burp",
        "nessus",
        "asv-scan",
        "asv-scans",
        "vuln",
        "vulns",
        "vulnerabilities",
        "security-scans"
      ],
      "segment_prefixes": [
        "zap-report",
        "pentest-",
        "pen-test-",
        "vuln-"
      ]
    },
    {
      "id": "path-people-hr",
      "segments": [
        "hr",
        "payroll",
        "salaries",
        "salary",
        "personnel",
        "people-ops",
        "compensation"
      ]
    },
    {
      "id": "path-backups-dumps",
      "segments": [
        "backup",
        "backups",
        "dump",
        "dumps",
        "db-dumps"
      ]
    },
    {
      "id": "path-logs",
      "segments": [
        "log",
        "logs"
      ]
    },
    {
      "id": "path-private",
      "segments": [
        "private",
        "confidential",
        "restricted"
      ]
    }
  ],
  "sensitive_names": [
    {
      "id": "name-credentials",
      "tokens": [
        "credential",
        "credentials",
        "creds",
        "password",
        "passwords",
        "passwd",
        "secret",
        "secrets",
        "apikey",
        "apikeys",
        "privkey",
        "kubeconfig",
        "mnemonic",
        "2fa",
        "otp",
        "totp"
      ],
      "phrases": [
        "access-credentials",
        "api-key",
        "api-keys",
        "private-key",
        "license-key",
        "recovery-codes",
        "backup-codes",
        "seed-phrase",
        "client-secret",
        "service-account",
        "secret-key",
        "access-key",
        "auth-token",
        "access-token",
        "refresh-token"
      ]
    },
    {
      "id": "name-token",
      "tokens": [
        "token",
        "tokens"
      ]
    },
    {
      "id": "name-ssh-keys",
      "prefixes": [
        "id_rsa",
        "id_dsa",
        "id_ecdsa",
        "id_ed25519"
      ]
    },
    {
      "id": "ext-secret-material",
      "exts": [
        ".env",
        ".pem",
        ".key",
        ".p12",
        ".pfx",
        ".jks",
        ".keystore",
        ".ovpn",
        ".ppk",
        ".asc",
        ".gpg",
        ".kdbx",
        ".tfstate",
        ".tfvars",
        ".netrc",
        ".npmrc",
        ".pypirc",
        ".pgpass",
        ".htpasswd",
        ".git-credentials",
        ".crt",
        ".cer",
        ".der",
        ".p8",
        ".mobileprovision",
        ".jwk"
      ]
    },
    {
      "id": "name-dotenv",
      "prefixes": [
        ".env"
      ]
    },
    {
      "id": "glob-cloud-credentials",
      "globs": [
        "service-account*.json",
        "*-sa.json",
        "client_secret*.json",
        "credentials*.json",
        "token*.json",
        "*_environment.json",
        "*.postman_environment.json",
        "*secret*.json",
        "*secrets*.yaml",
        "*secrets*.yml",
        "kubeconfig*"
      ]
    },
    {
      "id": "ext-correspondence",
      "exts": [
        ".eml",
        ".msg",
        ".mbox",
        ".pst",
        ".ost",
        ".emlx"
      ],
      "_why": "message bodies are never read — an e-mail kept in a document store stays metadata-only"
    }
  ],
  "name_allow": [
    {
      "id": "allow-password-policy",
      "applies_to": [
        "name-credentials"
      ],
      "regex": "passw(or)?d[-_ ]?(polic(y|ies)|reset|rotation|requirements?|manager|strength|guidelines?|standard)"
    },
    {
      "id": "allow-payment-tokenization",
      "applies_to": [
        "name-token",
        "name-credentials"
      ],
      "regex": "tokeni[sz](ation|ed|er|ing)|network[-_ ]?token|token[-_ ]?(service|vault|provisioning|lifecycle|requestor)|\\btsp\\b|device[-_ ]?token"
    },
    {
      "id": "allow-design-tokens",
      "applies_to": [
        "name-token"
      ],
      "regex": "design[-_ ]?tokens?|tokens?[-_ ]?(design|theme|colou?r|typograph)"
    },
    {
      "id": "allow-trade-secret-docs",
      "applies_to": [
        "name-credentials"
      ],
      "regex": "secret[-_ ]?sauce|trade[-_ ]?secrets?"
    },
    {
      "id": "allow-secret-management-docs",
      "applies_to": [
        "name-credentials"
      ],
      "regex": "secrets?[-_ ]?(management|manager|setup|policy|rotation|guide|handling|tenant[-_ ]guide)"
    }
  ],
  "archive_exts": [
    ".zip",
    ".tar",
    ".gz",
    ".tgz",
    ".7z",
    ".rar",
    ".jar",
